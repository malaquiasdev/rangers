#!/usr/bin/env bash
set -u
list=${AGENT_WATCH_LIST:-$HOME/.claude/agent-watch.txt}
limit=${1:-900}
interval=${AGENT_WATCH_INTERVAL:-120}

newest_in_dir() {
  local dir=$1 newest=0 t
  [ -d "$dir" ] || { echo 0; return; }
  t=$(find "$dir" \( -name node_modules -o -name .git -o -name vendor \) -prune -o -type f -print0 2>/dev/null \
    | xargs -0 stat -f %m 2>/dev/null | sort -n | tail -1)
  [ -n "$t" ] && newest=$t
  t=$(git -C "$dir" log -1 --format=%ct 2>/dev/null || true)
  [ -n "$t" ] && [ "$t" -gt "$newest" ] && newest=$t
  echo "$newest"
}

last_activity() {
  local file=$1; shift
  local newest=0 t dir
  [ -f "$file" ] && newest=$(stat -L -f %m "$file")
  for dir in "$@"; do
    t=$(newest_in_dir "$dir")
    [ "$t" -gt "$newest" ] && newest=$t
  done
  echo "$newest"
}

while true; do
  [ -s "$list" ] || { echo "lista vazia"; exit 0; }
  now=$(date +%s)
  while read -r name file dirs; do
    [ -n "$name" ] || continue
    case "$name" in \#*) continue ;; esac
    if [ ! -f "$file" ] && [ -z "$dirs" ]; then echo "SUMIU $name"; exit 0; fi
    last=$(last_activity "$file" $dirs)
    if [ "$last" -eq 0 ]; then echo "SUMIU $name"; exit 0; fi
    age=$(( now - last ))
    if [ "$age" -gt "$limit" ]; then
      echo "PARADO $name há $((age/60)) min (última atividade: $(date -r "$last" +%H:%M))"
      exit 0
    fi
  done < "$list"
  sleep "$interval"
done
