#!/usr/bin/env bash
set -euo pipefail
if [ $# -lt 4 ]; then
  echo "uso: audit <repo|lugar> <ação> <link> <por quê>" >&2
  exit 2
fi
dir="${BRAIN_DIR:-$HOME/Documents/brain}/claude/auditoria"
dia=$(TZ=America/Sao_Paulo date +%F)
f="$dir/$dia.md"
if [ ! -f "$f" ]; then
  printf -- '---\ntype: Log\ntitle: Auditoria %s\ndescription: "O que os agentes fizeram sem aprovação em %s: merge, push, deploy em dev, escrita no brain"\ntimestamp: %s\n---\n# Auditoria %s\n\n| hora | sessão | onde | ação | link | por quê |\n|---|---|---|---|---|---|\n' "$dia" "$dia" "$dia" "$dia" > "$f"
  printf -- '- [[claude/auditoria/%s|Auditoria %s]] — o que os agentes fizeram sozinhos\n' "$dia" "$dia" >> "$dir/index.md"
fi
sessao="${CLAUDE_SESSION_ID:-${AUDIT_SESSION:-?}}"
printf '| %s | %s | %s | %s | %s | %s |\n' "$(TZ=America/Sao_Paulo date +%H:%M)" "${sessao:0:8}" "$1" "$2" "$3" "$4" >> "$f"
