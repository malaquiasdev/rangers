#!/usr/bin/env bash
set -eu

raiz=$(git rev-parse --show-toplevel)
personagens=$(cat "$raiz/scripts/personagens.txt")

if ! head -1 "$1" | grep -qE '^(feat|fix|docs|chore|refactor|test|build|ci|perf|style|revert)(\([a-z0-9-]+\))?!?: .+'; then
  echo "a mensagem precisa seguir o Conventional Commits"
  exit 1
fi

if grep -qwE "$personagens" "$1"; then
  echo "nome de personagem na mensagem do commit"
  exit 1
fi
